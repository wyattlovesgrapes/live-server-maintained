{
  "name": "live-server-maintained",
  "version": "0.1.1",
  "description": "simple development http server with live reload capability",
  "keywords": [
    "front-end",
    "development",
    "tool",
    "server",
    "http",
    "cli"
  ],
  "author": "Tapio Vierros",
  "dependencies": {
    "chokidar": "^3.6.0",
    "colors": "1.4.0",
    "connect": "^3.7.0",
    "cors": "^2.8.5",
    "event-stream": "3.3.4",
    "faye-websocket": "0.11.x",
    "http-auth": "^4.2.1",
    "morgan": "^1.10.0",
    "object-assign": "^4.1.1",
    "opn": "^5.5.0",
    "proxy-middleware": "^0.15.0",
    "send": "^0.19.0",
    "serve-index": "^1.9.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "mocha": "^12.0.3",
    "supertest": "^7.1.1"
  },
  "scripts": {
    "lint": "eslint live-server.js index.js",
    "test": "mocha test --exit && npm run lint"
  },
  "bin": {
    "lvm": "./live-server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grape-corp/live-server-maintained.git"
  },
  "engines": {
    "node": ">=8.10.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "debug": "^2.6.9",
    "ms": "^2.1.3",
    "uuid": "^11.1.1"
  },
  "preferGlobal": true,
  "license": "MIT",
  "eslintConfig": {
    "env": {
      "node": true
    },
    "rules": {
      "quotes": 0,
      "curly": 0,
      "strict": 0,
      "no-process-exit": 0,
      "eqeqeq": 1,
      "no-unused-vars": 1,
      "no-shadow": 1
    }
  }
}
